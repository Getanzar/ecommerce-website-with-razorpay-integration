{
  "expo": {
    "name": "ZIYAMART",
    "slug": "ziyamart",
    "version": "1.1.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "in.ziyamart.app",
      "infoPlist": {
        "LSApplicationQueriesSchemes": [
          "tez",
          "phonepe",
          "paytmmp"
        ]
      }
    },
    "android": {
      "package": "in.ziyamart.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION"
      ]
    },
    "scheme": "ziyamart",
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-sharing",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "ZIYAMART uses selected photographs as evidence for return requests."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "ZIYAMART uses your location to validate delivery and business addresses. Riders can choose to share their location during an active delivery.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true,
          "locationAlwaysAndWhenInUsePermission": "Riders can share active delivery location in the background until the job ends or sharing is stopped."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "b750c57a-f077-4e76-9fe2-65eaf60e5672"
      }
    },
    "owner": "ziyamart"
  }
}
